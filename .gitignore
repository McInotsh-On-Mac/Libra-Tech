# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Environment variables file (contains Twitter API keys)
.env
.env.local
.env.development
.env.test
.env.production

# macOS system files
__MACOSX/
.DS_Store
.AppleDouble
.LSOverride
._*

# Build/distribution files 
dist/
build/
*.egg-info/

# Virtual environment folders
venv/
env/
ENV/
.venv

# Database files (if you create local SQLite files)
*.db
*.sqlite
*.sqlite3

# NLTK data (downloaded by your sentiment analysis)
nltk_data/

# Secret/config files
secret.key
secrets.py
config.py
*.key
*.pem

# Log files
*.log
logs/

# IDE/Editor files
.vscode/
.idea/
*.swp
*.swo

# Text output files (generated by your sentiment analysis)
raw_tweets.txt
cleaned_tweets.txt
tweet_analysis_results.txt
users_encrypted.txt

# Temporary files
*.tmp
*.temp

# Model files (if you save trained models)
*.pkl
*.joblib
*.model

# Test coverage reports
htmlcov/
.coverage
.pytest_cache/

# Jupyter notebook checkpoints
.ipynb_checkpoints/